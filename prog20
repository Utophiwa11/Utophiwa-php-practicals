<?php
    $conn = new mysqli("localhost", "root", "", "test_db");
    if ($conn->connect_error) {
        die("Connection failed: " . $conn->connect_error);
    }

    $sql = "SELECT 
                CURDATE() AS current_date_val,
                CURTIME() AS current_time_val,
                UNIX_TIMESTAMP() AS unix_time,
                FROM_UNIXTIME(UNIX_TIMESTAMP()) AS readable_time";

    $result = $conn->query($sql);
    $row = $result->fetch_assoc();

    echo "<b>1) CURDATE()/CURRENT_DATE:</b> " . $row["current_date_val"] . "<br>";
    echo "<b>2) CURTIME()/CURRENT_TIME():</b> " . $row["current_time_val"] . "<br>";
    echo "<b>3) UNIX_TIMESTAMP():</b> " . $row["unix_time"] . "<br>";
    echo "<b>4) FROM_UNIXTIME():</b> " . $row["readable_time"] . "<br>";

    $conn->close();
?>
