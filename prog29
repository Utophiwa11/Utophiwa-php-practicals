<?php
    if ($_SERVER["REQUEST_METHOD"] == "POST") {
        $username = $_POST["username"];
        $password = $_POST["password"];

        if (isset($_POST["remember"])) {
            // Store in cookies for 30 days
            setcookie("remember_user", $username, time() + (30 * 24 * 60 * 60));
            setcookie("remember_pass", $password, time() + (30 * 24 * 60 * 60));
        } else {
            // Clear cookies if remember me is unchecked
            setcookie("remember_user", "", time() - 3600);
            setcookie("remember_pass", "", time() - 3600);
        }

        echo "Login submitted for user: $username";
    }

    // Pre-fill values if cookies exist
    $savedUser = isset($_COOKIE["remember_user"]) ? $_COOKIE["remember_user"] : "";
    $savedPass = isset($_COOKIE["remember_pass"]) ? $_COOKIE["remember_pass"] : "";
?>

<form method="post">
    Username: <input type="text" name="username" value="<?php echo $savedUser; ?>" required><br><br>
    Password: <input type="password" name="password" value="<?php echo $savedPass; ?>" required><br><br>
    <input type="checkbox" name="remember" <?php if ($savedUser != "") echo "checked"; ?>> Remember Me<br><br>
    <input type="submit" value="Login">
</form>
