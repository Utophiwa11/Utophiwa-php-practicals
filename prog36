<?php
    $servername = "localhost";
    $username = "root";
    $password = "";
    $dbname = "test_db";

    // ---------- Using MySQLi ----------
    $conn = new mysqli($servername, $username, $password, $dbname);
    if ($conn->connect_error) die("Connection failed: " . $conn->connect_error);

    $stmt = $conn->prepare("DELETE FROM students WHERE id = ?");
    $deleteId = 2;
    $stmt->bind_param("i", $deleteId);

    if ($stmt->execute()) {
        echo "MySQLi: Record with ID $deleteId deleted successfully. Rows affected: " . $stmt->affected_rows . "<br>";
    } else {
        echo "Error: " . $conn->error . "<br>";
    }
    $stmt->close();
    $conn->close();

    // ---------- Using PDO ----------
    try {
        $pdo = new PDO("mysql:host=$servername;dbname=$dbname", $username, $password);
        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

        $stmt = $pdo->prepare("DELETE FROM teachers WHERE id = :id");
        $deleteId = 2;
        $stmt->bindParam(':id', $deleteId);
        $stmt->execute();

        echo "PDO: Record with ID $deleteId deleted successfully. Rows affected: " . $stmt->rowCount();
    } catch (PDOException $e) {
        echo "PDO Error: " . $e->getMessage();
    }
    $pdo = null;
?>
