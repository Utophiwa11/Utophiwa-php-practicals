<?php
    if ($_SERVER["REQUEST_METHOD"] == "POST") {
        $input = $_POST["arrValues"];
        $arr = explode(",", $input);
        $arr = array_map('trim', $arr);
        $arr = array_map('intval', $arr); // convert to numbers

        echo "Original Array: " . implode(", ", $arr) . "<br>";

        // Ascending order
        $ascArr = $arr;
        sort($ascArr);
        echo "Ascending Order (sort): " . implode(", ", $ascArr) . "<br>";

        // Descending order
        $descArr = $arr;
        rsort($descArr);
        echo "Descending Order (rsort): " . implode(", ", $descArr) . "<br>";
    }
?>

