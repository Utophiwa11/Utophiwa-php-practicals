<!DOCTYPE html>
<html>
<head>
    <title>Scroll to Top</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <style>
        body { height: 2000px; } /* long page to allow scrolling */
        #scrollBtn {
            position: fixed; bottom: 30px; right: 30px;
            padding: 10px 20px; font-size: 16px; cursor: pointer; display: none;
        }
    </style>
</head>
<body>
    <h1>Scroll down to see the button</h1>
    <button id="scrollBtn">Scroll to Top</button>

    <script>
        $(document).ready(function() {
            $(window).scroll(function() {
                if ($(this).scrollTop() > 200) {
                    $('#scrollBtn').fadeIn();
                } else {
                    $('#scrollBtn').fadeOut();
                }
            });

            $('#scrollBtn').click(function() {
                $('html, body').animate({ scrollTop: 0 }, 800); // smooth scroll
            });
        });
    </script>
</body>
</html>
