<?php
    // Using for loop
    echo "<b>Using for loop:</b><br>";
    for ($i = 5; $i <= 10; $i++) {
        echo $i . " ";
    }

    echo "<br><br><b>Using foreach loop:</b><br>";
    // foreach works on arrays, so create a range array first
    $numbers = range(5, 10);
    foreach ($numbers as $num) {
        echo $num . " ";
    }
?>
