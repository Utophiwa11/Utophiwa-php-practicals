<?php
    $servername = "localhost";
    $username = "root";
    $password = "";
    $dbname = "test_db";

    // ---------- Using MySQLi ----------
    $conn = new mysqli($servername, $username, $password, $dbname);
    if ($conn->connect_error) die("Connection failed: " . $conn->connect_error);

    echo "<b>MySQLi - First 3 records:</b><br>";
    $sql = "SELECT id, name, course FROM students LIMIT 3";
    $result = $conn->query($sql);

    while ($row = $result->fetch_assoc()) {
        echo "ID: " . $row["id"] . " | Name: " . $row["name"] . " | Course: " . $row["course"] . "<br>";
    }

    echo "<br><b>MySQLi - Records with OFFSET (skip 1, take 2):</b><br>";
    $sql2 = "SELECT id, name, course FROM students LIMIT 2 OFFSET 1";
    $result2 = $conn->query($sql2);
    while ($row = $result2->fetch_assoc()) {
        echo "ID: " . $row["id"] . " | Name: " . $row["name"] . "<br>";
    }
    $conn->close();

    // ---------- Using PDO ----------
    try {
        $pdo = new PDO("mysql:host=$servername;dbname=$dbname", $username, $password);
        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

        echo "<br><b>PDO - First 3 records:</b><br>";
        $stmt = $pdo->query("SELECT id, name, subject FROM teachers LIMIT 3");
        while ($row = $stmt->fetch(PDO::FETCH_ASSOC)) {
            echo "ID: " . $row["id"] . " | Name: " . $row["name"] . "<br>";
        }
    } catch (PDOException $e) {
        echo "PDO Error: " . $e->getMessage();
    }
    $pdo = null;
?>
