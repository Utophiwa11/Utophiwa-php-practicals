<?php
    $servername = "localhost";
    $username = "root";
    $password = "";
    $dbname = "test_db";

    // ---------- Using MySQLi ----------
    $conn = new mysqli($servername, $username, $password, $dbname);
    if ($conn->connect_error) die("Connection failed: " . $conn->connect_error);

    $stmt = $conn->prepare("UPDATE students SET course = ? WHERE id = ?");
    $newCourse = "MSc IT";
    $updateId = 1;
    $stmt->bind_param("si", $newCourse, $updateId);

    if ($stmt->execute()) {
        echo "MySQLi: Record updated successfully. Rows affected: " . $stmt->affected_rows . "<br>";
    } else {
        echo "Error: " . $conn->error . "<br>";
    }
    $stmt->close();
    $conn->close();

    // ---------- Using PDO ----------
    try {
        $pdo = new PDO("mysql:host=$servername;dbname=$dbname", $username, $password);
        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

        $stmt = $pdo->prepare("UPDATE teachers SET subject = :subject WHERE id = :id");
        $newSubject = "Web Technology";
        $updateId = 1;
        $stmt->bindParam(':subject', $newSubject);
        $stmt->bindParam(':id', $updateId);
        $stmt->execute();

        echo "PDO: Record updated successfully. Rows affected: " . $stmt->rowCount();
    } catch (PDOException $e) {
        echo "PDO Error: " . $e->getMessage();
    }
    $pdo = null;
?>
