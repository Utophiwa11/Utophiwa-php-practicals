<!DOCTYPE html>
<html>
<head>
    <title>AJAX Navigation Menu</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <style>
        nav a { margin-right: 15px; cursor: pointer; color: blue; text-decoration: underline; }
        #content { border: 1px solid #ccc; padding: 15px; margin-top: 15px; min-height: 100px; }
    </style>
</head>
<body>
    <h2>My Website</h2>
    <nav>
        <a data-page="home">Home</a>
        <a data-page="about">About</a>
        <a data-page="products">Products</a>
        <a data-page="contact">Contact</a>
    </nav>

    <div id="content">Click a menu item to load content.</div>

    <script>
        $(document).ready(function() {
            $("nav a").click(function() {
                var page = $(this).data("page");
                $.ajax({
                    url: "load_content.php",
                    method: "GET",
                    data: { page: page },
                    beforeSend: function() {
                        $("#content").html("Loading...");
                    },
                    success: function(response) {
                        $("#content").html(response);
                    }
                });
            });
        });
    </script>
</body>
</html>

<?php
    $page = $_GET["page"];

    switch ($page) {
        case "home":
            echo "<h3>Home</h3><p>Welcome to our website homepage!</p>";
            break;
        case "about":
            echo "<h3>About Us</h3><p>We are a leading company in web technology solutions.</p>";
            break;
        case "products":
            $conn = new mysqli("localhost", "root", "", "test_db");
            if ($conn->connect_error) die("Connection failed: " . $conn->connect_error);

            echo "<h3>Products</h3>";
            $result = $conn->query("SELECT name, course FROM students LIMIT 5");
            echo "<ul>";
            while ($row = $result->fetch_assoc()) {
                echo "<li>" . $row["name"] . " - " . $row["course"] . "</li>";
            }
            echo "</ul>";
            $conn->close();
            break;
        case "contact":
            echo "<h3>Contact Us</h3><p>Email: info@example.com | Phone: +91 9876543210</p>";
            break;
        default:
            echo "<p>Page not found.</p>";
    }
?>
